# apps/api/.env.example
# Copy to .env for local development. In the AWS sandbox these are set as
# Amplify secrets instead (see amplify/functions/api/resource.ts) - not read
# from a .env file there.

PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/habari
JWT_SECRET=change-me

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=
ADMIN_RECIPIENT_EMAIL=
ADMIN_CC_EMAIL=
ADMIN_BCC_EMAIL=

# Cloud storage (S3) - leave unset for local disk storage (uploads/ folder).
# Set CLOUD_STORAGE_BUCKET to switch to S3; the rest are optional depending
# on how the process authenticates to AWS.
# CLOUD_STORAGE_BUCKET=
# CLOUD_STORAGE_REGION=us-east-1
# CLOUD_STORAGE_PUBLIC_URL=https://<bucket>.s3.<region>.amazonaws.com
# CLOUD_STORAGE_ACCESS_KEY_ID=
# CLOUD_STORAGE_SECRET_ACCESS_KEY=
